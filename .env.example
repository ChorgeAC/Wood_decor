# --- Mode -------------------------------------------------------------------
# true: in-memory repos + fake Bedrock; no AWS account needed.
USE_MOCK=true
APP_ENV=dev
# Mock mode only: base URL used to build the fake "presigned" upload URLs.
MOCK_PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- AWS (leave credentials to the default provider chain / IAM role) ---------
AWS_REGION=us-east-1

# --- Bedrock models (verify availability in your region) ----------------------
CANVAS_MODEL_ID=amazon.nova-canvas-v1:0
VISION_MODEL_ID=amazon.nova-pro-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-image-v1
EMBEDDING_DIMENSIONS=1024
BEDROCK_READ_TIMEOUT_S=120
BEDROCK_CONNECT_TIMEOUT_S=5
BEDROCK_MAX_RETRIES=3
BEDROCK_BACKOFF_BASE_S=0.5

# --- Cost guardrails ----------------------------------------------------------
MAX_IMAGES_PER_REQUEST=3
MAX_IMAGE_BYTES=3750000

# --- Business rules -----------------------------------------------------------
SPECIES_REVIEW_THRESHOLD=0.6
ROOM_MIN_CONFIDENCE=0.5
PRICING_RULES_PROVIDED=false
# PRICING_RULES_PATH=./pricing_rules.json

# --- Real-AWS resources (required when USE_MOCK=false) ------------------------
# S3_BUCKET=
# CREATIONS_TABLE=
# SLABS_TABLE=
# PROFILES_TABLE=
# QUOTES_TABLE=
# OPENSEARCH_ENDPOINT=https://<collection-id>.us-east-1.aoss.amazonaws.com
# OPENSEARCH_INDEX=slab-embeddings
# SES_SENDER=quotes@example.com
# QUOTE_INBOX=orders@example.com
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
